# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# ── Database ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moveai
DB_USER=moveai
DB_PASSWORD=moveai
DB_ROOT_PASSWORD=rootpw

# ── AI Service ──────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── LLM (지식 추출) ─────────────────────────
LLM_API_KEY=
LLM_MODEL=

# ── Embedding ───────────────────────────────
# 모델을 바꾸면 저장된 벡터를 전부 재생성해야 한다.
EMBEDDING_MODEL=

# ── STT ─────────────────────────────────────
STT_MODEL=

# ── Storage ─────────────────────────────────
AUDIO_STORAGE_PATH=./data/audio

# ── Spring ──────────────────────────────────
# local = 실제 AI 호출 / demo = mock 클라이언트
SPRING_PROFILES_ACTIVE=local
