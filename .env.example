# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# ── Database ────────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_NAME=moveai
DB_USER=moveai
DB_PASSWORD=moveai
# Docker 배포 DB의 root 비밀번호는 MariaDB가 임의 생성한다.

# ── AI Service ──────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Gemini API ───────────────────────────────
# GOOGLE_API_KEY가 시스템에 있어도 앱은 이 값을 명시적으로 우선 사용한다.
GEMINI_API_KEY=

# ── LLM (지식 추출) ─────────────────────────
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal

# ── Embedding ───────────────────────────────
# 모델을 바꾸면 저장된 벡터를 전부 재생성해야 한다.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
# backend/에서 bootRun할 때 Python이 만든 시드 임베딩 산출물 경로
EMBEDDING_ARTIFACT=../data/embeddings/knowledge_embeddings.json
# 한 요청에 보낼 텍스트 수. API 상한은 100이고, 무료 등급은 분당 100건까지만
# 임베딩되므로(텍스트 1건 = 요청 1건) 50으로 나눠 보낸다.
EMBEDDING_BATCH_SIZE=50

# ── STT ─────────────────────────────────────
STT_MODEL=gemini-3.6-flash
STT_MAX_FILE_BYTES=10485760

# ── Kakao Map ───────────────────────────────
# 브라우저 지도 표시용 JavaScript 키. 허용 도메인을 반드시 등록한다.
KAKAO_MAP_JAVASCRIPT_KEY=

# 서버의 장소 검색·좌표 변환·자동차 길찾기 호출에만 사용한다.
# 브라우저에 노출되는 VITE_ 환경변수로 만들지 않는다.
KAKAO_REST_API_KEY=
KAKAO_LOCAL_API_URL=https://dapi.kakao.com
KAKAO_MOBILITY_API_URL=https://apis-navi.kakaomobility.com

# ── Storage ─────────────────────────────────
AUDIO_STORAGE_PATH=./data/audio

# ── Spring ──────────────────────────────────
# local = 실제 AI 호출 / demo = mock 클라이언트
SPRING_PROFILES_ACTIVE=local

# ── Production deployment ───────────────────
# 서버 공인 IP를 가리키는 실제 도메인. GitHub Pages와 통신하려면 HTTPS가 필수다.
API_DOMAIN=api.example.com
CORS_ALLOWED_ORIGINS=https://hyejishin-20.github.io
# 같은 80/443 Caddy에서 닿음 서비스를 함께 라우팅할 때 사용한다.
# 운영 배포에서는 docker-compose.yml의 기본값으로도 동작한다.
DAHUM_DOMAIN=yellow.it.kr
DAHUM_UPSTREAM=host.docker.internal:9000
