# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# ── Database ────────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_NAME=moveai
DB_USER=moveai
DB_PASSWORD=moveai
DB_ROOT_PASSWORD=rootpw

# ── AI Service ──────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Gemini API ───────────────────────────────
# GOOGLE_API_KEY가 시스템에 있어도 앱은 이 값을 명시적으로 우선 사용한다.
GEMINI_API_KEY=

# ── LLM (지식 추출) ─────────────────────────
LLM_MODEL=gemini-3.5-flash-lite
LLM_THINKING_LEVEL=minimal

# ── Embedding ───────────────────────────────
# 모델을 바꾸면 저장된 벡터를 전부 재생성해야 한다.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
# 한 요청에 보낼 텍스트 수. API 상한은 100이고, 무료 등급은 분당 100건까지만
# 임베딩되므로(텍스트 1건 = 요청 1건) 50으로 나눠 보낸다.
EMBEDDING_BATCH_SIZE=50

# ── STT ─────────────────────────────────────
STT_MODEL=gemini-3.6-flash
STT_MAX_FILE_BYTES=10485760

# ── Storage ─────────────────────────────────
AUDIO_STORAGE_PATH=./data/audio

# ── Spring ──────────────────────────────────
# local = 실제 AI 호출 / demo = mock 클라이언트
SPRING_PROFILES_ACTIVE=local
